# ADAPT-UI Environment Configuration
# Copy this file to .env for local development

# API Configuration
VITE_API_BASE_URL=http://localhost:3001
# VITE_WS_BASE_URL=ws://localhost:3001 # Optional, will be derived from API_BASE_URL

# Feature Flags
VITE_ENABLE_WEBSOCKET=true
VITE_ENABLE_CACHING=true
VITE_ENABLE_ANALYTICS=false

# Application Configuration
VITE_APP_NAME=ADAPT-UI
VITE_APP_VERSION=1.0.0
VITE_ENV=development # development | staging | production

# Debug Configuration
VITE_DEBUG=true
VITE_LOG_LEVEL=debug # debug | info | warn | error
